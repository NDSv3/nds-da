    xmlns:ndsda="http://www.example.org/ndsda"
    xsi:schemaLocation="http://www.example.org/ndsda ../../main/ndsdaNodeMapSchema.xsd" >
    
    <ndsda:PVMap>
        <ndsda:PV name="PV1" register="BASE.FIRST_REG" type="int32"/>
        <ndsda:PV name="PV2" register="BASE.SECOND_REG" type="float"/>
        <ndsda:PV name="PV3" register="BASE.THIRD_REG" type="float">
            <ndsda:ReadPV>PV3-Getter</ndsda:ReadPV>
            <ndsda:WritePV>PV3-Setter</ndsda:WritePV>
        </ndsda:PV>
        <ndsda:PV name="PV4" register=".DMA_SAMPLES" type="vector(uint32)" nElem="200"/>
    </ndsda:PVMap>

