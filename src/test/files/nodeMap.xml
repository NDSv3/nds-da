        <SerialNumber>xxx</SerialNumber>   <!- - VariableIn  string - ->
        <Model>xxx</Model>                 <!- - VariableIn  string - ->
        <Type>xxx</Type>                   <!- - VariableIn  string - ->
        <DriverVersion>xxx</DriverVersion> <!- - VariableIn  string - ->
        <ChassisNumber>xxx</ChassisNumber> <!- - VariableIn  int32  - ->
        <SlotNumber>xxx</SlotNumber>       <!- - VariableIn  int32  - ->
        <FilePath>xxx</FilePath>           <!- - DelegateOut string - ->
        <FilePath_RBV>xxx</FilePath_RBV>   <!- - VariableIn  string - ->
    </ndsda:FirmwareNode> -->
</ndsda:NodeMap>